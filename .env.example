# TEMPLATE ONLY: keep this file blank. Your real keys go in ".env" (same folder).
# ".env" is ignored by git, so your keys never get uploaded. Never paste keys in chat.

# M2: Gemini (Google AI Studio -> Get API key)
GEMINI_API_KEY=

# M3: Supabase (Project Settings -> API Keys). Use the NEW keys: secret key here (sb_secret_...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# M5: Telegram (BotFather token + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free photo search for stories without a picture (pexels.com/api)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
